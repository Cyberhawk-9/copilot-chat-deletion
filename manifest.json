{
  "manifest_version": 3,
  "name": "Copilot Chat Batch Delete Helper",
  "version": "1.0.0",
  "description": "Privacy-first batch cleanup for Microsoft Copilot chats using Copilot's own visible delete UI.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://copilot.microsoft.com/*",
    "https://www.copilot.com/*"
  ],
  "action": {
    "default_title": "Copilot Delete Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://www.copilot.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
